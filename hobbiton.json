{
    "$comment": "Hobbiton raises every Shire Studio starter kit from shared smials. Each kit lists its smials in order, later smials override earlier ones. raise, tend, survey, deliver and both CI workflows read this file.",
    "kits": {
        "vue": {
            "label": "Vue",
            "repository": "shire-studio/laravel-starter-kit-vue",
            "node": true,
            "smials": [
                "common",
                "auth",
                "web",
                "inertia",
                "inertia-vue"
