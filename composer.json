{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "shire-studio/hobbiton",
    "type": "project",
    "description": "Raises every Shire Studio Laravel starter kit from shared smials.",
    "license": "MIT",
    "require": {
        "php": "^8.5.0",
        "laravel/framework": "^13.0",
        "laravel/prompts": "^0.3.26"
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "laravel/vet": "^0.2.1",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^5.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "lint": "pint --parallel",
        "test": [
            "pint --parallel --test",
            "pest",
            "node --test tests/scripts/*.test.js"
        ],
        "smials:pint": "pint --parallel smials",
        "tend": [
            "Composer\\Config::disableProcessTimeout",
            "node scripts/tend.js"
        ],
        "survey": [
            "Composer\\Config::disableProcessTimeout",
            "node scripts/survey.js"
        ],
        "harvest": [
            "Composer\\Config::disableProcessTimeout",
            "node scripts/harvest.js"
        ],
        "deliver": [
            "Composer\\Config::disableProcessTimeout",
            "node scripts/deliver.js"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "laravel/vet": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
